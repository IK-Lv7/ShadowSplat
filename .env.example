# Copy to .env (never commit it)
NUSCENES_RAW=/path/to/nuscenes        # directory containing v1.0-mini, samples/ and sweeps/
SHADOWSPLAT_DATA=./data               # where preprocessed data and outputs go

# Phase 2 (CloudKit server-to-server key; Public Database only)
CLOUDKIT_CONTAINER=iCloud.com.example.shadowsplat
CLOUDKIT_ENV=development              # development | production
CLOUDKIT_KEY_ID=
CLOUDKIT_PRIVATE_KEY_PATH=/path/to/eckey.pem

# Phase 3 (runtimes for the reconstruction jobs)
DRIVESTUDIO_PYTHON=/path/to/envs/drivestudio/bin/python
SEGFORMER_PYTHON=/path/to/envs/segformer/bin/python
SEGFORMER_REPO=/path/to/SegFormer
SEGFORMER_CKPT=/path/to/segformer.b5.1024x1024.city.160k.pth

# Phase 5 (ACDC: adverse-condition real images with labels; register, download, extract val/val_ref)
ACDC_ROOT=/path/to/acdc

# Phase 6 (demo video encoding; e.g. the ffmpeg bundled with imageio-ffmpeg)
FFMPEG_EXE=/path/to/ffmpeg
